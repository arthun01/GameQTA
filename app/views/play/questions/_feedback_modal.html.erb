<div id="feedback_modal" data-controller="modal" class="fixed inset-0 z-50 flex items-center justify-center p-6 bg-slate-900/80 backdrop-blur-sm" role="dialog" aria-modal="true">
  <div class="w-full max-w-sm flex flex-col rounded-2xl overflow-hidden shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1)] bg-white relative">
    <!-- Header de Erro -->
    <div class="flex flex-col items-center p-5 gap-3 bg-red-50 border-b border-red-200">
      <div class="flex items-center justify-center rounded-3xl shrink-0 bg-red-500 size-12 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <div class="font-bold text-red-800 text-xl">
        <%= t(".incorrect", default: "Resposta Incorreta") %>
      </div>
    </div>
    
    <!-- Corpo -->
    <div class="flex flex-col p-6 gap-4">
      <div class="uppercase tracking-wide font-semibold text-slate-500 text-sm">
        <%= t(".understand_error", default: "Entenda o erro") %>
      </div>
      <div class="text-[15px] leading-relaxed text-slate-700">
        <%= @question.feedback_article %>
      </div>
    </div>
    
    <!-- Rodapé -->
    <div class="flex flex-col pt-2 pb-6 px-6">
      <%= button_to play_theme_attempt_question_path(@theme_attempt), method: :get, class: "w-full p-4 rounded-xl bg-blue-500 hover:bg-blue-600 transition-colors shadow flex items-center justify-center cursor-pointer", form: { data: { turbo: false } } do %>
        <span class="font-semibold text-white text-base">
          <%= t(".next_question", default: "Próxima Questão") %>
        </span>
      <% end %>
    </div>
  </div>
</div>
