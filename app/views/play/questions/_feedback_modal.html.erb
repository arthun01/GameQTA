<dialog open id="feedback_modal" data-controller="modal" data-modal-auto-open-value="true" aria-labelledby="feedback-title" class="w-full max-w-md rounded-2xl bg-white p-6 text-slate-800 shadow-xl">
  <h2 id="feedback-title" tabindex="-1" data-dialog-heading class="mb-4 text-xl font-bold text-red-900"><%= t('play.questions.feedback_modal.incorrect') %></h2>
  <p class="mb-3 font-semibold"><%= t('play.questions.feedback_modal.understand_error') %></p>
  <div class="mb-6 whitespace-pre-line leading-relaxed"><%= @question.feedback_article %></div>
  <button type="button" data-action="modal#close" class="mb-4 rounded-lg border border-slate-500 px-4 py-2"><%= t('accessibility.close') %></button>
  <%= link_to t('play.questions.feedback_modal.next_question'), play_theme_attempt_question_path(@theme_attempt), data: { turbo_frame: '_top' }, class: 'block rounded-xl bg-emerald-800 p-4 text-center font-semibold text-white' %>
</dialog>
