<div class="flex items-center py-3 px-4 rounded-xl shadow-sm bg-white">
  <div class="w-8 shrink-0 font-sans font-extrabold text-gray-500 text-base/5">
    <%= position %>
  </div>
  <div class="flex flex-col grow basis-[0%]">
    <div class="font-sans font-bold text-gray-800 text-sm/4.5">
      <%= leaderboard.user.full_name %>
    </div>
    <div class="font-sans font-medium text-gray-500 text-xs/4">
      <%= t('rankings.index.time_format', min: leaderboard.total_time_taken / 60, sec: leaderboard.total_time_taken % 60) %>
    </div>
  </div>
  <div class="font-sans font-extrabold text-emerald-500 text-sm/4.5">
    <%= t('rankings.index.points', count: leaderboard.total_score) %>
  </div>
</div>
