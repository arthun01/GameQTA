<div class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center justify-between">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-bold tracking-tight" style="color: #064e3b;">Gestão da Equipe</h1>
      <p class="mt-2 text-sm text-slate-500">Uma lista com todos os administradores do painel.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to "Novo Administrador", new_admin_admin_path, class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg shadow-sm text-sm font-semibold text-white transition-opacity duration-300 hover:opacity-90", style: "background-color: #064e3b;" %>
    </div>
  </div>
  
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden bg-white shadow-sm border border-slate-100 sm:rounded-2xl">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50 border-b border-slate-100">
              <tr>
                <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-wider text-slate-400 sm:pl-6">E-mail</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-400">Data de Criação</th>
                <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Ações</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% @admins.each do |admin_user| %>
                <tr id="<%= dom_id(admin_user) %>" class="hover:bg-slate-50 transition-colors duration-200">
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6"><%= admin_user.email_address %></td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500"><%= admin_user.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <div class="flex items-center justify-end gap-3">
                      <%= link_to "Editar", edit_admin_admin_path(admin_user), class: "text-sm font-semibold hover:underline", style: "color: #064e3b;" %>
                      <% if Admin.count > 1 && admin_user != Current.admin %>
                        <span class="text-slate-300">|</span>
                        <%= button_to "Excluir", admin_admin_path(admin_user), method: :delete, class: "text-sm font-semibold text-red-500 hover:text-red-700 hover:underline bg-transparent border-none cursor-pointer p-0", form: { class: "inline-block" } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>