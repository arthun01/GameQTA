<%= form_with(model: [:admin, level], class: "space-y-6") do |f| %>
  <% if level.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= t("errors.template.header", count: level.errors.count, model: t('activerecord.models.level.one', default: 'Nível')) %>
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% level.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-6 sm:gap-x-6">
    <div class="sm:col-span-4">
      <%= f.label :name, t('.name', default: 'Nome'), class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= f.text_field :name, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :icon, t('.icon', default: 'Ícone (Emoji)'), class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= f.text_field :icon, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md", placeholder: "🎮" %>
      </div>
    </div>

    <div class="sm:col-span-6">
      <%= f.label :description, t('.description', default: 'Descrição'), class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= f.text_area :description, rows: 4, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>
  </div>

  <div class="pt-5 border-t border-gray-200">
    <div class="flex justify-end">
      <%= link_to t('admin.shared.cancel', default: 'Cancelar'), admin_levels_path, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= f.submit t('admin.shared.save', default: 'Salvar'), class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  </div>
<% end %>

