<div class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-bold tracking-tight" style="color: #064e3b;">Dashboard</h1>
      <p class="mt-2 text-sm text-slate-500">Visão geral do sistema e engajamento da comunidade de estudantes.</p>
    </div>
  </div>

  <dl class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3">
    <div class="flex flex-col justify-between overflow-hidden rounded-2xl bg-white px-6 py-6 shadow-sm border border-slate-100 hover:shadow-md transition-shadow duration-300 min-h-[140px]">
      <dt class="text-sm font-semibold text-slate-500 leading-snug">Total de Estudantes</dt>
      <dd class="mt-4 text-3xl font-extrabold tracking-tight" style="color: #064e3b;"><%= @total_students %></dd>
    </div>
    
    <div class="flex flex-col justify-between overflow-hidden rounded-2xl bg-white px-6 py-6 shadow-sm border border-slate-100 hover:shadow-md transition-shadow duration-300 min-h-[140px]">
      <dt class="text-sm font-semibold text-slate-500 leading-snug">Média Global de Acertos</dt>
      <dd class="mt-4 text-3xl font-extrabold tracking-tight" style="color: #064e3b;"><%= @global_accuracy %>%</dd>
    </div>
    
    <div class="flex flex-col justify-between overflow-hidden rounded-2xl bg-white px-6 py-6 shadow-sm border border-slate-100 hover:shadow-md transition-shadow duration-300 min-h-[140px]">
      <dt class="text-sm font-semibold text-slate-500 leading-snug">Temas Concluídos</dt>
      <dd class="mt-4 text-3xl font-extrabold tracking-tight" style="color: #064e3b;"><%= @themes_completed %></dd>
    </div>
  </dl>
</div>