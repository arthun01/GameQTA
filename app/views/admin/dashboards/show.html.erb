<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold leading-6 text-gray-900">Dashboard</h1>
      <p class="mt-2 text-sm text-gray-700">Visão geral do sistema e engajamento da comunidade de estudantes.</p>
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Total de Estudantes</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_students %></dd>
    </div>
    
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Média Global de Acertos</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @global_accuracy %>%</dd>
    </div>
    
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Temas Concluídos</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @themes_completed %></dd>
    </div>
  </dl>
</div>
