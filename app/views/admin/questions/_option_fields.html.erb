<div class="nested-fields flex items-start space-x-3 p-4 border border-gray-200 rounded-md bg-gray-50 mb-3" data-new-record="<%= f.object.new_record? %>">
  <div class="flex-shrink-0 mt-1">
    <%= f.check_box :is_correct, class: "is-correct-radio h-5 w-5 text-blue-600 focus:ring-blue-500 border-gray-300 rounded-full cursor-pointer", data: { action: "change->nested-form#selectCorrect" } %>
  </div>
  
  <div class="flex-1">
    <%= f.label :content, "Texto da Opção", class: "sr-only" %>
    <%= f.text_field :content, class: "shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md", placeholder: "Digite a opção de resposta..." %>
    <%= f.hidden_field :_destroy %>
  </div>
  
  <div class="flex-shrink-0">
    <button type="button" data-action="nested-form#remove" class="text-gray-400 hover:text-red-500 focus:outline-none">
      <span class="sr-only">Remover Opção</span>
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  </div>
</div>

