<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-800 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-800 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("accessibility.admin_login") %></h1>

  <%= form_with url: admin_session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :email_address, t("accessibility.admin_email") %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("admin.sessions.new.email_placeholder"), value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-emerald-700 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password, t("accessibility.admin_password") %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t("admin.sessions.new.password_placeholder"), maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-emerald-700 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit t("accessibility.admin_login"), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-emerald-800 hover:bg-emerald-900 text-white inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to t("accessibility.admin_forgot_password"), new_admin_password_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
