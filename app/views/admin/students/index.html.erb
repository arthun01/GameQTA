<div class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-bold tracking-tight" style="color: #064e3b;">Estudantes (Moderação)</h1>
      <p class="mt-2 text-sm text-slate-500">Lista completa de estudantes da plataforma. Use o bloqueio apenas em casos extremos de violação de regras.</p>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden bg-white shadow-sm border border-slate-100 sm:rounded-2xl">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50 border-b border-slate-100">
              <tr>
                <th scope="col" class="py-4 pl-4 pr-3 text-left text-xs font-bold uppercase tracking-wider text-slate-400 sm:pl-6">Nome</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-400">E-mail</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-400">Cidade</th>
                <th scope="col" class="px-3 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-400">Status</th>
                <th scope="col" class="relative py-4 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Ações</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white" id="students">
              <%= render partial: "admin/students/student", collection: @students %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>