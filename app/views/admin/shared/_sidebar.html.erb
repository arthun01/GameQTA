<aside class="w-64 bg-white border-r border-gray-200 h-screen flex flex-col hidden md:flex">
  <div class="h-16 flex items-center px-6 border-b border-gray-200">
    <%= link_to admin_root_path, class: "text-xl font-bold text-gray-900" do %>
      <%= t('admin.app_name', default: 'Painel Admin') %>
    <% end %>
  </div>

  <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
    <%= link_to admin_root_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_root_path) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}" do %>
      <svg class="mr-3 h-5 w-5 <%= current_page?(admin_root_path) ? 'text-blue-700' : 'text-gray-400' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Dashboard
    <% end %>

    <%= link_to admin_levels_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_levels_path) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}" do %>
      <svg class="mr-3 h-5 w-5 <%= current_page?(admin_levels_path) ? 'text-blue-700' : 'text-gray-400' %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <%= t('admin.sidebar.levels', default: 'Níveis') %>
    <% end %>

    <%= link_to admin_students_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_students_path) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}" do %>
      <svg class="mr-3 h-5 w-5 <%= current_page?(admin_students_path) ? 'text-blue-700' : 'text-gray-400' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      Estudantes
    <% end %>
    <%= link_to admin_reports_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_reports_path) || current_page?(students_admin_reports_path) || current_page?(themes_admin_reports_path) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}" do %>
      <svg class="mr-3 h-5 w-5 <%= current_page?(admin_reports_path) || current_page?(students_admin_reports_path) || current_page?(themes_admin_reports_path) ? 'text-blue-700' : 'text-gray-400' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Relatórios
    <% end %>
  </nav>

  <div class="p-4 border-t border-gray-200">
    <%= button_to admin_session_path, method: :delete, class: "flex w-full items-center px-3 py-2 text-sm font-medium text-red-600 rounded-md hover:bg-red-50" do %>
      <svg class="mr-3 h-5 w-5 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <%= t('admin.sidebar.logout', default: 'Sair') %>
    <% end %>
  </div>
</aside>
