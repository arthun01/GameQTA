<% content_for :title, t(".title") %>

<div class="min-h-screen flex items-center justify-center p-4 bg-linear-to-br from-emerald-100 to-teal-100">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl overflow-hidden p-8 border border-emerald-100 my-8">
    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-blue-500 rounded-2xl mx-auto flex items-center justify-center mb-4 shadow-lg shadow-blue-200 -rotate-3">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight"><%= t(".join_us") %></h1>
      <p class="text-sm text-gray-500 mt-2"><%= t(".subtitle") %></p>
    </div>

    <%= form_with model: @user, url: "/cadastrar", class: "space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="p-4 mb-4 text-sm text-red-800 rounded-xl bg-red-50 border border-red-100">
          <ul class="list-disc list-inside space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :full_name, t(".full_name_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.text_field :full_name, required: true, autofocus: true, placeholder: "João da Silva", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :age, t(".age_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= form.number_field :age, required: true, min: 5, max: 120, placeholder: "15", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" %>
        </div>
        
        <div>
          <%= form.label :city, t(".city_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= form.text_field :city, required: true, placeholder: "São Paulo", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" %>
        </div>
      </div>

      <div>
        <%= form.label :education_level, t(".education_level_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <div class="relative">
          <%= form.select :education_level, User.education_levels.keys.map { |key| [t("activerecord.attributes.user/education_level.#{key}"), key] }, { prompt: t(".select_education") }, class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors appearance-none" %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :email_address, t(".email_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "seu@email.com", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" %>
      </div>

      <div>
        <%= form.label :password, t(".password_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors" %>
      </div>

      <div class="pt-4">
        <%= form.submit t(".submit"), class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-blue-200 transition-all active:scale-95 cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-8 text-center text-sm text-gray-600">
      <%= t(".has_account") %>
      <%= link_to t(".login_link"), "/entrar", class: "font-semibold text-blue-600 hover:text-blue-500 hover:underline" %>
    </div>
  </div>
</div>
