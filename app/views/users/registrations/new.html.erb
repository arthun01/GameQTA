<% content_for :title, t(".title") %>

<div class="min-h-screen flex items-center justify-center p-4 bg-linear-to-br from-emerald-100 to-teal-100">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl overflow-hidden p-8 border border-emerald-100 my-8">
    <div class="text-center mb-8">
      <img src="/logo_qta.png" style="width: 110px;" class="h-auto mx-auto mb-6 object-contain drop-shadow-sm hover:scale-105 transition-transform duration-300">
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight"><%= t(".join_us") %></h1>
      <p class="text-sm text-gray-500 mt-2"><%= t(".subtitle") %></p>
    </div>

    <%= form_with model: @user, url: "/cadastrar", class: "space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="p-4 mb-4 text-sm text-red-800 rounded-xl bg-red-50 border border-red-100">
          <ul class="list-disc list-inside space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :full_name, t(".full_name_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.text_field :full_name, required: true, autofocus: true, placeholder: "João da Silva", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :age, t(".age_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= form.number_field :age, required: true, min: 5, max: 120, placeholder: "15", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors" %>
        </div>
        
        <div>
          <%= form.label :city, t(".city_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= form.text_field :city, placeholder: t("users.profiles.city_placeholder"), maxlength: 100, class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors" %>
        </div>
      </div>

      <div>
        <%= form.label :education_level, t(".education_level_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <div class="relative">
          <%= form.select :education_level, User.education_levels.keys.map { |key| [t("activerecord.attributes.user/education_level.#{key}"), key] }, { prompt: t(".select_education") }, class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors appearance-none" %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :email_address, t(".email_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "seu@email.com", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors" %>
      </div>

      <div>
        <%= form.label :password, t(".password_label"), class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-4 py-3 rounded-xl border-gray-200 bg-gray-50 text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:bg-white transition-colors" %>
      </div>

      <p class="text-sm leading-relaxed text-slate-600"><%= t("users.profiles.optional_fields") %></p>
      <%= render "shared/legal_acceptance_fields", form: form %>

      <div class="pt-4">
        <%= form.submit t(".submit"), class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-emerald-200 transition-all active:scale-95 cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-8 text-center text-sm text-gray-600">
      <%= t(".has_account") %>
      <%= link_to t(".login_link"), "/entrar", class: "font-semibold text-emerald-600 hover:text-emerald-700 hover:underline" %>
    </div>
  </div>
</div>
