<% content_for :title, t(".title") %>
<div class="mx-auto max-w-3xl space-y-8 px-5 py-10 sm:px-8">
  <header>
    <%= link_to t("users.profiles.back_to_game"), jornada_path, class: "text-sm font-semibold text-emerald-900 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4" %>
    <h1 class="mt-5 text-3xl font-bold text-emerald-950"><%= t(".title") %></h1>
    <p class="mt-3 leading-relaxed text-slate-700"><%= t(".description") %></p>
  </header>

  <section aria-labelledby="profile-data-title" class="rounded-2xl border border-emerald-100 bg-white p-6 sm:p-8">
    <h2 id="profile-data-title" class="text-xl font-bold text-emerald-950"><%= t(".data_title") %></h2>
    <dl class="mt-6 grid gap-5 sm:grid-cols-2">
      <% { full_name: @user.full_name, email_address: @user.email_address, age: @user.age, city: @user.city, education_level: @user.education_level.present? ? t("activerecord.attributes.user/education_level.#{@user.education_level}") : nil }.each do |attribute, value| %>
        <div class="min-w-0">
          <dt class="text-sm font-semibold text-slate-600"><%= User.human_attribute_name(attribute) %></dt>
          <dd class="mt-1 break-words text-slate-900"><%= value.presence || t("users.profiles.not_informed") %></dd>
        </div>
      <% end %>
    </dl>
    <%= link_to t(".edit"), edit_profile_path, class: "mt-6 inline-flex min-h-11 items-center rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-800" %>
  </section>

  <section aria-labelledby="acceptance-history-title" class="rounded-2xl border border-emerald-100 bg-white p-6 sm:p-8">
    <h2 id="acceptance-history-title" class="text-xl font-bold text-emerald-950"><%= t(".acceptance_history") %></h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-700"><%= t(".acceptance_explanation") %></p>
    <% if @user.legal_acceptances.exists? %>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-700">
        <% @user.legal_acceptances.order(accepted_at: :desc).each do |acceptance| %>
          <li><%= t(".acceptance_record", terms: acceptance.terms_version, privacy: acceptance.privacy_version, date: l(acceptance.accepted_at, format: "%d/%m/%Y %H:%M %Z")) %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate-700"><%= t(".no_acceptance") %></p>
    <% end %>
  </section>

  <section id="delete-account" aria-labelledby="delete-account-title" class="rounded-2xl border border-red-200 bg-white p-6 sm:p-8">
    <h2 id="delete-account-title" class="text-xl font-bold text-red-900"><%= t(".delete_title") %></h2>
    <p class="mt-3 leading-relaxed text-slate-700"><%= t(".delete_effects") %></p>
    <p class="mt-3 leading-relaxed text-slate-700"><%= t(".retention_limits") %></p>
    <div class="mt-5"><%= render "shared/form_errors", record: @user %></div>
    <%= form_with scope: :user, url: profile_path, method: :delete, class: "mt-6 space-y-5", data: { turbo: false } do |form| %>
      <div>
        <%= form.label :current_password, t("users.profiles.current_password"), class: "mb-2 block text-sm font-semibold text-slate-800" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-emerald-800" %>
      </div>
      <div class="flex items-start gap-3">
        <%= form.check_box :deletion_confirmed, required: true, class: "mt-1 h-5 w-5 shrink-0 rounded border-slate-400 focus:ring-2 focus:ring-red-800" %>
        <%= form.label :deletion_confirmed, t(".delete_confirmation"), class: "text-sm leading-relaxed text-slate-800" %>
      </div>
      <%= form.submit t(".delete_submit"), class: "min-h-11 cursor-pointer rounded-lg bg-red-800 px-5 py-3 font-semibold text-white hover:bg-red-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-800" %>
    <% end %>
  </section>
</div>
