<% content_for :title, t(".title") %>
<div class="mx-auto max-w-2xl space-y-6 px-5 py-10 sm:px-8">
  <header>
    <%= link_to t(".cancel"), profile_path, class: "text-sm font-semibold text-emerald-900 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4" %>
    <h1 class="mt-5 text-3xl font-bold text-emerald-950"><%= t(".title") %></h1>
    <p class="mt-3 leading-relaxed text-slate-700"><%= t(".description") %></p>
  </header>
  <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-5 rounded-2xl border border-emerald-100 bg-white p-6 sm:p-8", data: { turbo: false } do |form| %>
    <%= render "shared/form_errors", record: @user %>
    <% [ :full_name, :email_address, :age, :city ].each do |attribute| %>
      <div>
        <%= form.label attribute, class: "mb-2 block text-sm font-semibold text-slate-800" %>
        <% field_options = { required: attribute != :city, class: "w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-emerald-800" } %>
        <% if attribute == :age %>
          <%= form.number_field attribute, **field_options, min: 5, max: 120 %>
        <% elsif attribute == :email_address %>
          <%= form.email_field attribute, **field_options, autocomplete: "email" %>
        <% else %>
          <%= form.text_field attribute, **field_options, maxlength: 100 %>
        <% end %>
      </div>
    <% end %>
    <div>
      <%= form.label :education_level, class: "mb-2 block text-sm font-semibold text-slate-800" %>
      <%= form.select :education_level, User.education_levels.keys.map { |key| [t("activerecord.attributes.user/education_level.#{key}"), key] }, { include_blank: t("users.profiles.not_informed") }, class: "w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-emerald-800" %>
      <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= t("users.profiles.optional_fields") %></p>
    </div>
    <div>
      <%= form.label :current_password, t("users.profiles.current_password"), class: "mb-2 block text-sm font-semibold text-slate-800" %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-emerald-800" %>
    </div>
    <%= form.submit t(".submit"), class: "min-h-11 cursor-pointer rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-800" %>
  <% end %>
</div>
