<%= form.hidden_field :legal_revision, value: LegalDocument.revision %>
<div class="space-y-3 rounded-xl border border-emerald-100 bg-emerald-50 p-4 text-sm leading-relaxed text-slate-800">
  <p><%= t("shared.legal_acceptance.version", version: LegalDocument.version) %></p>
  <p><%= t("shared.legal_acceptance.draft") %></p>
  <div class="flex flex-wrap gap-x-5 gap-y-2">
    <%= link_to t("shared.legal_links.terms"), terms_path, target: "_blank", rel: "noopener", class: "text-emerald-900 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4" %>
    <%= link_to t("shared.legal_links.privacy"), privacy_policy_path, target: "_blank", rel: "noopener", class: "text-emerald-900 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4" %>
  </div>
  <p class="text-xs"><%= t("shared.legal_acceptance.new_tab") %></p>
  <div class="flex items-start gap-3 pt-1">
    <%= form.check_box :legal_documents_accepted, required: true, checked: false, class: "mt-1 h-5 w-5 shrink-0 rounded border-slate-400 focus:ring-2 focus:ring-emerald-800" %>
    <%= form.label :legal_documents_accepted, t("shared.legal_acceptance.label"), class: "leading-relaxed" %>
  </div>
  <p class="text-xs"><%= t("shared.legal_acceptance.distinction") %></p>
</div>
