<% content_for :title, t('.title') %>

<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-lg">
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-display font-semibold tracking-tight text-(--color-text-primary)">
      <%= t('.title') %>
    </h1>
    <p class="text-sm text-(--color-text-muted) mt-2">
      <%= t('.subtitle') %>
    </p>
  </div>

  <div class="space-y-6">
    <% @levels.each do |level| %>
      <% if level.starting_level? %>
        <!-- Nível Liberado -->
        <div class="bg-(--color-surface-elevated) rounded-(--radius-xl) shadow-(--shadow-elevated) border border-(--color-border) overflow-hidden relative">
          <div class="p-6">
            <h2 class="text-xl font-bold text-(--color-text-primary)"><%= level.name %></h2>
            <p class="text-sm text-(--color-text-muted) mt-1"><%= level.description %></p>
            <div class="mt-6 flex justify-end">
              <%= link_to t('.play'), "#", class: "inline-flex items-center gap-2 px-6 py-3 rounded-full bg-(--color-primary) hover:bg-(--color-primary-hover) text-white font-semibold transition shadow" %>
            </div>
          </div>
        </div>
      <% else %>
        <!-- Nível Bloqueado com Modal -->
        <div data-controller="modal" class="relative">
          <!-- Card Trigger -->
          <button type="button" data-action="click->modal#open" class="w-full text-left bg-(--color-surface) rounded-(--radius-xl) border border-(--color-border) p-6 opacity-75 hover:opacity-100 transition shadow-sm relative overflow-hidden flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-(--color-text-muted)"><%= level.name %></h2>
              <p class="text-sm text-(--color-text-muted) mt-1"><%= level.description %></p>
            </div>
            <div class="text-(--color-text-muted) pl-4">
              <!-- Ícone de Cadeado -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
          </button>

          <!-- Bottom Sheet / Modal (Hidden by default) -->
          <div data-modal-target="dialog" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
            <!-- Overlay -->
            <div class="fixed inset-0 bg-black/50 transition-opacity" data-action="click->modal#close" aria-hidden="true"></div>

            <!-- Modal Panel -->
            <div class="fixed inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center p-0 sm:p-4">
              <div class="bg-(--color-surface-elevated) w-full sm:max-w-md rounded-t-(--radius-xl) sm:rounded-b-(--radius-xl) shadow-(--shadow-elevated) p-6 transform transition-all max-h-[80vh] flex flex-col mt-auto sm:mt-0">
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-lg font-bold text-(--color-text-primary)" id="modal-title">
                    <%= level.name %>
                  </h3>
                  <button type="button" data-action="click->modal#close" class="text-(--color-text-muted) hover:text-(--color-text-primary)">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
                
                <p class="text-sm text-(--color-text-muted) mb-6">
                  <%= t('.locked_message') %>
                </p>

                <div class="overflow-y-auto flex-1">
                  <h4 class="text-sm font-semibold text-(--color-text-primary) mb-3 uppercase tracking-wider"><%= t('.themes_preview') %></h4>
                  <% if level.themes.any? %>
                    <ul class="space-y-3">
                      <% level.themes.each do |theme| %>
                        <li class="bg-(--color-surface) border border-(--color-border) rounded-(--radius-md) p-4 flex items-center justify-between">
                          <span class="text-sm font-medium text-(--color-text-primary)"><%= theme.name %></span>
                          <!-- Ícone visual (modo leitura) -->
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-(--color-text-muted)" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                          </svg>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    <p class="text-sm text-(--color-text-muted) italic"><%= t('.no_themes') %></p>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @levels.empty? %>
      <div class="text-center py-12 bg-(--color-surface) rounded-(--radius-lg) border border-(--color-border)">
        <p class="text-(--color-text-muted)"><%= t('.empty_levels') %></p>
      </div>
    <% end %>
  </div>
</div>

