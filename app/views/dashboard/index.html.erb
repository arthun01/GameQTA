<% content_for :title, t('.title') %>

<div class="min-h-screen flex items-start sm:items-center justify-center p-4 bg-gradient-to-br from-emerald-100 to-teal-100">
  
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl overflow-hidden border border-emerald-100 my-8">
    
    <!-- Cabeçalho / Navbar Superior -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-emerald-50 bg-white">
       <!-- Logo e Nome do Lado Esquerdo -->
       <div class="flex items-center gap-2">
        <img src="/logo_qta.png" alt="Game QTA" class="w-6 h-6 object-contain">
        <span class="text-emerald-500 font-bold text-lg tracking-tight">Game QTA</span>
      </div>
  
  <!-- Avatar do Lado Direito -->
  <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold text-sm">
    A
  </div>
</div>

<!-- Título da Página -->
<div class="px-6 pt-6 pb-4 text-left bg-emerald-50/30 border-b border-emerald-50">
  <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
    <%= t('.title') %>
  </h1>
  <p class="text-sm text-slate-500 mt-1">
    <%= t('.subtitle', default: 'Explore o mapa do Game QTA e conquiste os níveis.') %>
  </p>
</div>

    <div class="p-5 sm:p-6 flex flex-col gap-3">
      <% @levels.each_with_index do |level, index| %>
        
        <% if index > 0 %>
          <!-- Linha do Tempo -->
          <div class="w-1 h-6 bg-emerald-100 mx-auto rounded-full"></div>
        <% end %>

        <% if level.starting_level? %>
          
          <!-- ==========================================
               Fase Atual
               ========================================== -->
          <details class="bg-white rounded-3xl border-2 border-emerald-400 shadow-sm overflow-hidden group hover:shadow-md transition-all">
            <summary class="p-4 sm:p-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
              <div class="flex items-start gap-4">
                
                <div class="w-16 h-16 min-w-[64px] flex-none shrink-0 rounded-2xl overflow-hidden border border-emerald-100 bg-emerald-50/50 flex items-center justify-center shadow-sm">
                 <img src="/ods-<%= level.id %>.png" onerror="this.src='/logo_qta.png'" style="width: 170%; height: auto; max-width: none;" class="object-center" alt="<%= level.name %>">
                </div>

                <div class="flex-1 min-w-0 pt-0.5">
                  <div class="flex justify-between items-start gap-2">
                    <div class="min-w-0">
                      <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider block truncate">Nível <%= index + 1 %></span>
                      <h2 class="text-base font-bold text-gray-900 leading-tight mt-0.5"><%= level.name %></h2>
                    </div>
                    
                    <span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-1 rounded-lg shrink-0 flex-none text-center leading-tight">
                      Em<br>Progresso
                    </span>
                  </div>
                  <p class="text-[13px] text-gray-500 mt-1.5 line-clamp-2 leading-tight"><%= level.description %></p>
                </div>
              </div>

              <div class="mt-4 w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm py-3 rounded-xl flex justify-center items-center gap-2 transition-colors">
                <span><%= t('.play_theme', default: 'Jogar') %></span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            
            <!-- ==========================================
                 Área de Temas 
                 ========================================== -->
            <div class="px-4 sm:px-5 pb-6 pt-4 border-t border-gray-100 bg-white">
              <h4 class="text-[11px] font-bold text-gray-400 mb-4 uppercase tracking-widest"><%= t('.themes', default: "Temas disponíveis") %></h4>
              <% if level.themes.any? %>
                <ul class="space-y-3">
                  <!-- Usamos each_with_index para gerar os números automaticamente -->
                  <% level.themes.each_with_index do |theme, t_index| %>
                    <li class="bg-white border border-gray-200 rounded-2xl px-4 py-3.5 flex items-center justify-between hover:border-emerald-300 hover:shadow-sm transition-all group">
                      
                      <!-- Número e Título do Tema -->
                      <span class="text-[14px] font-semibold text-slate-600 leading-tight flex-1">
                        <%= t_index + 1 %>. <%= theme.name %>
                      </span>
                      
                      <!-- Botão 'Iniciar' como texto subtil -->
                      <%= button_to t('.play_theme', default: "Iniciar"), start_play_theme_path(theme), class: "shrink-0 ml-3 text-emerald-600 font-bold text-[13px] transition-colors group-hover:text-emerald-700 active:scale-95 bg-transparent p-0 cursor-pointer" %>
                      
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-xs text-gray-500 italic"><%= t('.no_themes') %></p>
              <% end %>
            </div>
          </details>

        <% else %>
          
          <!-- ==========================================
               Fase Bloqueada 
               ========================================== -->
          <div data-controller="modal" class="relative">
            
            <button type="button" data-action="click->modal#open" class="w-full text-left bg-white rounded-2xl border border-gray-200 p-3 sm:p-4 hover:bg-gray-50 transition-colors group shadow-xs">
              <div class="flex items-center gap-3 sm:gap-4">
                
                <div class="w-12 h-12 min-w-[48px] flex-none shrink-0 rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 flex items-center justify-center grayscale opacity-60 transition-transform group-hover:scale-105">
                 <img src="/ods-<%= level.id %>.png" onerror="this.src='/logo_qta.png'" style="width: 170%; height: auto; max-width: none;" class="object-center" alt="<%= level.name %>">
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex justify-between items-center gap-2">
                    <div class="min-w-0">
                      <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block truncate">Nível <%= index + 1 %></span>
                      <h2 class="text-[14px] font-bold text-gray-600 leading-tight truncate mt-0.5 group-hover:text-gray-800 transition-colors"><%= level.name %></h2>
                    </div>
                    
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 shrink-0 flex-none" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  
                  <div class="mt-1.5 flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-400 shrink-0 flex-none" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-[11px] font-medium text-gray-500 truncate">Alcance a meta no Nível anterior</span>
                  </div>
                </div>
              </div>
            </button>

            <!-- Modal do Nível Bloqueado -->
            <div data-modal-target="dialog" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
              <div class="fixed inset-0 bg-black/60 transition-opacity" data-action="click->modal#close" aria-hidden="true"></div>
              <div class="fixed inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center p-0 sm:p-4">
                <div class="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-b-3xl shadow-xl p-6 transform transition-all max-h-[80vh] flex flex-col mt-auto sm:mt-0">
                  <div class="flex justify-between items-center mb-5 border-b border-gray-100 pb-4">
                    <h3 class="text-lg font-bold text-gray-900" id="modal-title"><%= level.name %></h3>
                    <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 p-1.5 rounded-full transition-colors">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                  </div>
                  
                  <p class="text-sm text-emerald-800 bg-emerald-50 p-4 rounded-xl mb-6 border border-emerald-100"><%= t('.locked_message') %></p>

                  <div class="overflow-y-auto flex-1">
                    <h4 class="text-xs font-bold text-gray-400 mb-3 uppercase tracking-widest"><%= t('.themes_preview') %></h4>
                    <% if level.themes.any? %>
                      <ul class="space-y-3">
                        <% level.themes.each do |theme| %>
                          <li class="bg-gray-50 border border-gray-100 rounded-xl p-3 flex items-center justify-between">
                            <span class="text-sm font-medium text-gray-600"><%= theme.name %></span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                            </svg>
                          </li>
                        <% end %>
                      </ul>
                    <% else %>
                      <p class="text-sm text-gray-400 italic"><%= t('.no_themes') %></p>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @levels.empty? %>
        <div class="text-center py-12 bg-gray-50 rounded-3xl border border-dashed border-gray-200 mt-4">
          <p class="text-sm text-gray-500"><%= t('.empty_levels') %></p>
        </div>
      <% end %>
    </div>
    
      <div class="mt-auto pt-8 pb-8 flex flex-col items-center justify-center w-full" style="background-color: #ecfdf5;">
        <!-- Logo TEKOHAlab -->
        <div class="pb-5">
          <img src="/tekohalab.png" alt="TEKOHAlab" style="height: 72px; width: auto; mix-blend-mode: multiply;" class="object-contain">
        </div>
        
        <!-- Créditos  -->
        <div class="flex flex-col items-center gap-1.5">
          <span class="text-[10px] font-bold uppercase tracking-widest" style="color: #064e3b; opacity: 0.65;">Desenvolvido por</span>
          
          <div class="flex flex-wrap justify-center items-center gap-x-3 gap-y-1 text-[13px] font-semibold" style="color: #064e3b;">
            <a href="https://www.linkedin.com/in/ana-beatriz-guerra-mello-290693364" target="_blank" rel="noopener noreferrer" class="hover:opacity-50 transition-opacity duration-300">Ana Beatriz</a>
            <span class="text-[10px]" style="color: #064e3b; opacity: 0.3;">•</span>
            <a href="https://www.linkedin.com/in/arthurrv/" target="_blank" rel="noopener noreferrer" class="hover:opacity-50 transition-opacity duration-300">Arthur</a>
            <span class="text-[10px]" style="color: #064e3b; opacity: 0.3;">•</span>
            <a href="https://www.linkedin.com/in/raffscardoso/" target="_blank" rel="noopener noreferrer" class="hover:opacity-50 transition-opacity duration-300">Rafael</a>
          </div>
        </div>
      </div>
  </div>
</div>